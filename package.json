  "private": true,
  "description": "joetay.com \u2014 static site + Netlify Functions (lead capture)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsksa/property-sg-lp.git"
  },
  "homepage": "https://joetay.com",
  "license": "UNLICENSED",
  "author": "Joe Tay <joe@joetay.com>",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run check:new-launches-generated && node scripts/check-consistency.mjs && node scripts/check-new-launches.mjs && npm run test:new-launches && npm run test:lighthouse",
    "generate:new-launches": "node scripts/generate-new-launch-index.mjs",
    "check:new-launches-generated": "node scripts/generate-new-launch-index.mjs --check",
    "test:contrast": "node --test tests/color-contrast.test.mjs",
    "test:lighthouse": "node --test tests/color-contrast.test.mjs tests/lighthouse-accessibility.test.mjs",
    "test:new-launches": "node --test tests/new-launches-data.test.mjs tests/new-launch-catalog.test.mjs",
    "test:search-growth": "node --test tests/search-growth-report.test.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9"
  }
}
