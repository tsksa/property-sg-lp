# Copy to .env, fill in, then:  set -a && source .env && set +a
# Never commit the filled-in .env.

# From Google Ads > Tools > API Center (on the MANAGER account).
# Needs Basic Access to query production accounts - see README.
export GOOGLE_ADS_DEVELOPER_TOKEN=

# From Google Cloud Console > Credentials > OAuth client ID (Desktop app).
export GOOGLE_ADS_CLIENT_ID=
export GOOGLE_ADS_CLIENT_SECRET=

# Produced by: python get_refresh_token.py
export GOOGLE_ADS_REFRESH_TOKEN=

# Your manager (MCC) account - Joe Tay.
export GOOGLE_ADS_LOGIN_CUSTOMER_ID=948-996-2292

# The account the campaigns actually live in.
export GOOGLE_ADS_CUSTOMER_ID=435-311-8591
